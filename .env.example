# =====================================================================
#  volvo-mqtt configuration
#  Lives at /home/pi/portainer_data/volvo-mqtt/.env on hal
#  Tokens are persisted (and rotated) in ./data/tokens.json
# =====================================================================

# ---- Volvo Cars Developer Portal (developer.volvocars.com) ----------
VCC_API_KEY=your_vcc_api_key
# Leave blank to auto-discover the first vehicle on your Volvo ID
VOLVO_VIN=

# ---- OAuth 2.0 (Volvo ID) -------------------------------------------
# Client credentials of your published API application.
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Volvo application.
# The dashboard serves this path (/callback) for the "Connect Volvo ID" button.
VOLVO_REDIRECT_URI=http://volvo.yoururl.com/callback
# Powertrain: bev = fully electric (battery), phev = plug-in hybrid (battery + fuel), ice = petrol/diesel
POWERTRAIN=bev
# Scopes for a fully electric car. For phev add conve:fuel_status; for ice swap
# energy:state:read for conve:fuel_status. Leave blank to use the POWERTRAIN default.
VOLVO_SCOPES=openid energy:state:read conve:odometer_status conve:doors_status conve:lock_status conve:lock conve:unlock location:read

# Seed tokens - optional. The easiest way to connect is the "Connect Volvo ID"
# button on the dashboard. Only needed to seed or replace a token by hand.
# After that the app refreshes automatically and stores the rotated
# refresh token in data/tokens.json - you do NOT need to update this file.
# Alternatively run the interactive login (see README) instead.
VOLVO_REFRESH_TOKEN=
# Optional: a short-lived test access token from the developer portal
VOLVO_ACCESS_TOKEN=

# Renew the access token this many seconds before it expires
TOKEN_REFRESH_MARGIN=300

# Endpoints (defaults shown; normally leave alone)
#VOLVO_TOKEN_URL=https://volvoid.eu.volvocars.com/as/token.oauth2
#VOLVO_AUTHORIZE_URL=https://volvoid.eu.volvocars.com/as/authorization.oauth2
#VOLVO_API_BASE=https://api.volvocars.com/connected-vehicle/v2
#VOLVO_LOCATION_BASE=https://api.volvocars.com/location/v1
#VOLVO_ENERGY_BASE=https://api.volvocars.com/energy/v2

# ---- Polling and rate limiting --------------------------------------
# Seconds between polls (minimum 300 enforced). Each poll = 3 requests,
# plus 1 for location when due.
POLL_INTERVAL=600
LOCATION_POLL_INTERVAL=900
ENABLE_LOCATION=true
# Client-side caps (Volvo limit is ~100/min; 90 is the hard ceiling here)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=2000
# Minimum seconds between lock/unlock commands
COMMAND_COOLDOWN=30
# Seconds after a command before re-reading the lock state
COMMAND_REFRESH_DELAY=20
# Minimum seconds between manual refreshes (MQTT /refresh or dashboard)
MANUAL_REFRESH_MIN_INTERVAL=120

# ---- MQTT -----------------------------------------------------------
MQTT_HOST=192.168.1.55
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=volvo-mqtt
MQTT_TOPIC_PREFIX=volvo/vehicle
MQTT_RETAIN=true
MQTT_TLS=false

# ---- Web dashboard --------------------------------------------------
WEB_ENABLED=true
WEB_PORT=8084

# Login (required when the site is publicly reachable)
WEB_AUTH_ENABLED=true
WEB_USERNAME=admin
# Generate with: docker compose run --rm volvo-mqtt python -m volvo_mqtt.webauth
WEB_PASSWORD_HASH=
# Plain-text alternative (not recommended); ignored if WEB_PASSWORD_HASH is set
WEB_PASSWORD=
WEB_SESSION_HOURS=12
# Lock an IP out for WEB_LOGIN_LOCKOUT_MINUTES after this many failed logins
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_LOCKOUT_MINUTES=15
# true when behind a reverse proxy (OpenResty/Nginx) that sets X-Forwarded-For/-Proto
WEB_TRUST_PROXY=false
# auto = Secure cookie when the proxy reports https; or true/false
WEB_COOKIE_SECURE=auto
# Show Lock/Unlock buttons on the dashboard (anyone on your LAN can use them)
WEB_ENABLE_CONTROLS=false
# Optional PIN required for dashboard lock/unlock
WEB_CONTROL_PIN=
# Public Terms and Conditions / Privacy Notice (/terms and /privacy)
SITE_OWNER=Mark Beets
# Shown on the legal pages as the contact address (leave blank to hide)
SITE_CONTACT_EMAIL=
LEGAL_UPDATED=20 October 2026

# Optional (phev/ice only): tank size in litres, to show fuel as a percentage
FUEL_TANK_LITRES=

LOG_LEVEL=INFO
